{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".project/methis-docs/context/USING-VAULT.md",
    ".project/methis-docs/Methis.md"
  ],
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": ["npx", "-y", "obsidian-mcp-server@3.2.9"],
      "environment": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_LOG_LEVEL": "info",
        "OBSIDIAN_API_KEY": "{env:OBSIDIAN_API_KEY}",
        "OBSIDIAN_BASE_URL": "https://127.0.0.1:27126",
        "OBSIDIAN_VERIFY_SSL": "false",
        "OBSIDIAN_ENABLE_COMMANDS": "false"
      },
      "enabled": true
    }
  }
}
